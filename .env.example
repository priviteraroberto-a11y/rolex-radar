# Copia in .env per l'uso locale. Su GitHub questi diventano "Secrets".

# --- Telegram ---------------------------------------------------------------
# Token: scrivi a @BotFather → /newbot
TELEGRAM_BOT_TOKEN=
# Chat id: scrivi al tuo bot, poi apri
# https://api.telegram.org/bot<TOKEN>/getUpdates e leggi result[0].message.chat.id
TELEGRAM_CHAT_ID=

# --- IMAP: lettura degli alert dei marketplace -------------------------------
# Gmail: host imap.gmail.com, password = "password per le app" (non quella normale)
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASS=

# --- SMTP: invio del report email -------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
REPORT_TO=
